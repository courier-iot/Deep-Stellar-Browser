<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Search" app:iconSpaceReserved="false">
        <ListPreference
            android:key="search_engine"
            android:title="Search engine"
            android:defaultValue="ddg"
            android:entries="@array/engine_names"
            android:entryValues="@array/engine_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="suggest_enabled"
            android:title="Address bar suggestions"
            android:summary="Matches your bookmarks (and history, if on) as you type. Done on the phone — nothing is sent to a search engine."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="searx_url"
            android:title="SearXNG instance"
            android:defaultValue="https://searx.be"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="custom_search_url"
            android:title="Custom search address (use %s for the words)"
            android:defaultValue=""
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="bangs_enabled"
            android:title="Search shortcuts (bangs)"
            android:summary="!gh rust searches GitHub, !w black hole Wikipedia, !aw example.com the Wayback Machine. Worked out on the phone."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="bangs_bare"
            android:title="Shortcuts without the !"
            android:summary="gh rust works too (keywords of 2+ letters). Off by default so ordinary searches aren&apos;t hijacked."
            android:defaultValue="false"
            android:dependency="bangs_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="bangs_manage"
            android:title="Your shortcuts"
            android:summary="See the built-in ones and add your own"
            android:dependency="bangs_enabled"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Tabs" app:iconSpaceReserved="false">
        <SeekBarPreference
            android:key="tab_limit_index"
            android:title="Maximum tabs"
            android:defaultValue="3"
            android:max="6"
            app:min="0"
            app:showSeekBarValue="false"
            app:updatesContinuously="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="desktop_default"
            android:title="Desktop site by default"
            android:summary="New tabs request the desktop version of pages"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="bar_bottom"
            android:title="Address bar at the bottom"
            android:summary="Easier to reach with one hand"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="pull_refresh"
            android:title="Pull down to reload"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Performance" app:iconSpaceReserved="false">
        <SeekBarPreference
            android:key="cpu_mode"
            android:title="CPU limiter"
            android:defaultValue="1"
            android:max="3"
            app:min="0"
            app:showSeekBarValue="false"
            app:updatesContinuously="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            android:key="ram_limit_index"
            android:title="RAM limiter"
            android:defaultValue="3"
            android:max="6"
            app:min="0"
            app:showSeekBarValue="false"
            app:updatesContinuously="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="ultra_no_images"
            android:title="No images in Ultra-eco"
            android:summary="Skip loading images when the CPU limiter is on Ultra-eco"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Ad shield" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="adblock_enabled"
            android:title="Block ads &amp; trackers"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="adblock_learning"
            android:title="Self-learning blocker"
            android:summary="Learns what ads look like and catches ones no list has seen. Stores only hashed numbers — never URLs."
            android:defaultValue="true"
            android:dependency="adblock_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="adblock_cosmetic"
            android:title="Hide leftover ad boxes"
            android:defaultValue="true"
            android:dependency="adblock_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="update_lists"
            android:title="Update filter lists"
            android:summary="Download StevenBlack hosts + AdGuard DNS filter"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="filter_auto"
            android:title="Update lists automatically"
            android:defaultValue="0"
            android:entries="@array/filter_auto_names"
            android:entryValues="@array/filter_auto_values"
            android:dependency="adblock_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="filter_wifi_only"
            android:title="Automatic updates on Wi-Fi only"
            android:defaultValue="true"
            android:dependency="adblock_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="reset_learning"
            android:title="Reset learning"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="clear_user_blocks"
            android:title="Clear my blocked domains"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="clear_allowed"
            android:title="Clear allowed sites"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="adblock_rules"
            android:title="Advanced filter rules"
            android:summary="EasyList and EasyPrivacy in full, which catches ads served from a site&apos;s own domain. Downloaded with Update filter lists."
            android:defaultValue="true"
            android:dependency="adblock_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="cookie_banners"
            android:title="Deal with cookie banners"
            android:summary="Taps Reject when a banner offers it, hides the banner otherwise. Never taps Accept."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Privacy" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="https_only"
            android:title="HTTPS-only mode"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="strip_trackers"
            android:title="Clean links"
            android:summary="Remove tracking tags (utm_, fbclid, gclid…) and skip Google/Facebook click-through redirects"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="block_3p_cookies"
            android:title="Block third-party cookies"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="send_gpc"
            android:title="Send Global Privacy Control"
            android:summary="Tells sites not to sell or share your data"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="js_enabled"
            android:title="JavaScript"
            android:summary="Turning this off breaks many sites but removes most tracking scripts"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="webrtc_mode"
            android:title="WebRTC IP protection"
            android:defaultValue="relay"
            android:entries="@array/webrtc_names"
            android:entryValues="@array/webrtc_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="site_settings"
            android:title="Site settings"
            android:summary="Per-site camera, microphone, location, JavaScript, text size"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="fp_resist"
            android:title="Fingerprint resistance"
            android:summary="Adds noise to canvas and audio readouts and reports common device values. Partial: sites can still tell browsers apart in other ways."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="referrer_trim"
            android:title="Hide the page you came from"
            android:summary="Other sites get no referrer at all. Off by default: some sites refuse images or logins without one."
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="app_lock"
            android:title="App lock"
            android:summary="Fingerprint, face or your screen-lock PIN to open Deep Stellar"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="app_lock_after"
            android:title="Lock after leaving the app"
            android:defaultValue="0"
            android:entries="@array/app_lock_after_names"
            android:entryValues="@array/app_lock_after_values"
            android:dependency="app_lock"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="panic_tile"
            android:title="Panic wipe tile"
            android:summary="A Quick Settings button that stops downloads and torrents, wipes site data, and closes Deep Stellar instantly — even from the lock screen"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="panic_history"
            android:title="Panic wipe also erases history"
            android:summary="Only matters if encrypted history is on"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="secure_screen"
            android:title="Hide from screenshots &amp; recents"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="tor_proxy"
            android:title="Route through Tor (Orbot)"
            android:summary="Requires the Orbot app running. If Orbot is off, pages won't load — nothing leaks."
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="proxy_host"
            android:title="Orbot HTTP proxy"
            android:defaultValue="127.0.0.1:8118"
            android:dependency="tor_proxy"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="wipe_now"
            android:title="Wipe site data now"
            android:summary="Cookies, cache, storage. Also happens automatically every time you exit."
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="History (optional)" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="history_enabled"
            android:title="Save encrypted history"
            android:summary="Off by default. When on, visited pages are saved in an AES-256 encrypted file whose key never leaves this phone's secure hardware."
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="history_days"
            android:title="Keep history for"
            android:defaultValue="30"
            android:entries="@array/history_days_names"
            android:entryValues="@array/history_days_values"
            android:dependency="history_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="history_lock"
            android:title="Lock with fingerprint / PIN"
            android:summary="Ask to unlock every time you open History"
            android:defaultValue="true"
            android:dependency="history_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="history_pause_tor"
            android:title="Pause while using Tor"
            android:summary="Nothing is recorded while browsing through Orbot"
            android:defaultValue="true"
            android:dependency="history_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="suggest_history"
            android:title="Suggest from history"
            android:summary="History suggestions appear without the fingerprint/PIN lock — turn off if others use this phone"
            android:defaultValue="true"
            android:dependency="history_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="history_open"
            android:title="Open history"
            android:dependency="history_enabled"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Start page" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="start_show_rec"
            android:title="Show Recommended"
            android:summary="Projects, Wikipedia, Maps, Archive, GitHub, APOD, r/space, HN, Bookmarks"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="start_show_mine"
            android:title="Show Your shortcuts"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="projects_check"
            android:title="Check GitHub for project news"
            android:summary="Every 6 hours, look for new projects, updates and releases for the Projects page. Contacts GitHub's public API only, through your Tor setting."
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="projects_notify"
            android:title="Notify me about project news"
            android:defaultValue="true"
            android:dependency="projects_check"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="manage_shortcuts"
            android:title="Manage your shortcuts"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Look" app:iconSpaceReserved="false">
        <ListPreference
            android:key="theme"
            android:title="Theme"
            android:defaultValue="nebula"
            android:entries="@array/theme_names"
            android:entryValues="@array/theme_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="starfield"
            android:title="Animated starfield"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="force_dark"
            android:title="Darken websites"
            android:summary="Ask pages to render dark (Android 13+)"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            android:key="text_zoom"
            android:title="Text size on websites (%)"
            android:defaultValue="100"
            android:max="200"
            app:min="50"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="reader_font"
            android:title="Reader mode font"
            android:defaultValue="serif"
            android:entries="@array/reader_font_names"
            android:entryValues="@array/reader_font_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            android:key="reader_size"
            android:title="Reader mode text size (%)"
            android:defaultValue="100"
            android:max="200"
            app:min="70"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="reader_width"
            android:title="Reader mode column width"
            android:defaultValue="normal"
            android:entries="@array/reader_width_names"
            android:entryValues="@array/reader_width_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Downloads &amp; torrents" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="download_ask"
            android:title="Ask where to save each download"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="transfers_remember"
            android:title="Remember unfinished downloads and torrents"
            android:summary="So they can be resumed after the browser closes. Finished ones are never recorded. Panic wipe forgets them."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="torrent_down"
            android:title="Download limit (KB/s, 0 = none)"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="torrent_up"
            android:title="Upload limit (KB/s, 0 = none)"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="torrent_seed"
            android:title="Keep seeding after download"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="torrent_seed_ratio"
            android:title="Stop seeding at share ratio"
            android:defaultValue="0"
            android:entries="@array/seed_ratio_names"
            android:entryValues="@array/seed_ratio_values"
            android:dependency="torrent_seed"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="torrent_seed_minutes"
            android:title="Stop seeding after"
            android:defaultValue="0"
            android:entries="@array/seed_time_names"
            android:entryValues="@array/seed_time_values"
            android:dependency="torrent_seed"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="torrent_max_active"
            android:title="Torrents downloading at once"
            android:defaultValue="3"
            android:entries="@array/torrent_active_names"
            android:entryValues="@array/torrent_active_values"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="torrent_start_paused"
            android:title="Add torrents paused"
            android:summary="So you can pick files in Details before anything downloads"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="torrent_wifi_only"
            android:title="Torrents on Wi-Fi only"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="torrent_vpn_only"
            android:title="Torrents only while a VPN is connected"
            android:summary="Torrents can&apos;t use Tor, so this stops them exposing your address when the VPN drops"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="torrent_dir_pick"
            android:title="Save torrents to"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Backup" app:iconSpaceReserved="false">
        <Preference
            android:key="backup_create"
            android:title="Create encrypted backup"
            android:summary="Settings, bookmarks, your block list — optionally history and the learned ad model — in one password-protected file. No cloud."
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="auto_backup_enabled"
            android:title="Automatic backups"
            android:summary="Encrypted backups on a schedule, to a folder you choose"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="auto_backup_status"
            android:title="Back up now"
            android:dependency="auto_backup_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="auto_backup_folder_pick"
            android:title="Backup folder"
            android:dependency="auto_backup_enabled"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="auto_backup_freq"
            android:title="How often"
            android:defaultValue="1"
            android:entries="@array/auto_freq_names"
            android:entryValues="@array/auto_freq_values"
            android:dependency="auto_backup_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            android:key="auto_backup_keep"
            android:title="Keep the newest"
            android:defaultValue="5"
            android:entries="@array/auto_keep_names"
            android:entryValues="@array/auto_keep_values"
            android:dependency="auto_backup_enabled"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="auto_backup_charging"
            android:title="Only while charging"
            android:defaultValue="false"
            android:dependency="auto_backup_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="auto_backup_history"
            android:title="Include history"
            android:summary="Only if encrypted history is on"
            android:defaultValue="false"
            android:dependency="auto_backup_enabled"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="auto_backup_model"
            android:title="Include learned ad model"
            android:defaultValue="true"
            android:dependency="auto_backup_enabled"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="backup_restore"
            android:title="Restore from backup"
            android:summary="Replaces this phone's settings and bookmarks with the backup's"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Crash reports" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:key="crash_log"
            android:title="Save crash reports on this phone"
            android:summary="Only app version, Android version, device model and the error — addresses are blanked out. Never sent anywhere unless you share one."
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="crash_reports"
            android:title="View crash reports"
            android:dependency="crash_log"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="About" app:iconSpaceReserved="false">
        <Preference
            android:key="about"
            android:title="Deep Stellar Browsing"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
