    <!-- front half of ring -->
    <group android:rotation="-22" android:pivotX="54" android:pivotY="54">
        <path android:strokeColor="#9BD4FF" android:strokeWidth="2.2" android:fillColor="#00000000"
            android:pathData="M81,54 A27,7 0 0,1 27,54"/>
